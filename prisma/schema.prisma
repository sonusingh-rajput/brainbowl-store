// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  FAILED
}

model Product {
  id              String   @id @default(uuid())
  name            String
  sku             String?  @unique
  price           Int      // selling price in paise (e.g. 49900 = ₹499.00)
  originalPrice   Int?     // MRP / Regular price in paise (e.g. 79900 = ₹799.00)
  stock           Int      @default(0)
  imageUrl        String?  // <-- Added Image Link URL
  description     String?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
}

model Order {
  id                String   @id @default(uuid())
  receiptId         String   @unique
  amount            Int      // Base product price
  shippingCost      Int      @default(0) // <-- Added Shipping Cost in paise (0 = Free)
  status            String   // "PAID", "PENDING", "CANCELLED"
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  awbNumber         String?
  courierUrl        String?
  deliveredAt       DateTime?

  // Return / Refund Facility
  returnReason      String?  // e.g. "Damaged Item", "Wrong Item", "Quality Issue", "Expired", "Other"
  returnDetails     String?  // Customer problem description
  returnUpi         String?  // Customer UPI ID for refund
  returnStatus      String?  // "PENDING", "APPROVED", "REJECTED", "COMPLETED"
  returnRequestedAt DateTime?
  returnAdminNotes  String?  // Admin notes / decision reason

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productId         String
  product           Product  @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  level     String // INFO, WARN, ERROR
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String // "REGISTER" or "FORGOT_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StoreSetting {
  id                  String   @id @default("global")
  freeShippingMinAmount Int    @default(99900) // Default ₹999 in paise
  standardShippingFee Int      @default(9900)  // Default ₹99 in paise
  updatedAt           DateTime @updatedAt
}